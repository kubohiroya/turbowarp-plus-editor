-left\n        opacity: 0.85\n        buttonAsset: CameraSelect\n    overlay:\n      visible: true\n      jointStyles:\n        leftWrist:\n          color: '#ff00aa'\n          opacity: 0.8\n          radius: 6\n        rightWrist:\n          color: '#ff00aa'\n          opacity: 0.8\n          radius: 6\n      boneStyle:\n        color: '#00e5ff'\n        opacity: 0.9\n        width: 3\n      minimumConfidence: 0.5\n      confidenceScaling:\n        jointOpacity: true\n        boneOpacity: true\n\nscenes:\n  earthquake:\n    - stage: Classroom\n    - Student.show:\n        skin: StudentReady\n        x: -90\n        y: -55\n        scale: 58\n    - Student.say:\n        text: 地震だ！\n        seconds: 2\n  instruction:\n    - stage: EarthquakeClassroom\n    - Student.say:\n        text: 自分の身を守るため、丈夫な机の下に入り、両手で頭を守ろう！\n        seconds: 4\n  protect:\n    recognitionModel: SafetyPose\n    actions:\n      - stage: EarthquakeClassroom\n      - Student.show:\n          skin: ProtectHead\n          x: 0\n          y: -60\n          scale: 65\n      - Student.pose:\n          steps:\n            - pose: 頭を守る\n              skin: ProtectHead\n              sound: SuccessSound\n  success:\n    - stage: EarthquakeClassroom\n    - Student.show:\n        skin: ProtectHead\n        x: 0\n        y: -60\n        scale: 65\n    - Student.say:\n        text: できた！ 頭を守れたね。揺れがおさまるまで、そのまま待とう。\n        seconds: 5\n    - wait: 1\n","cacheIdentity":{"id":"4016c237438c942222ea4c7c1bbfabef","label":"story.kamishibai.yaml","databaseName":"tw-kamishibai-assets-v1--story--4016c237438c942222ea4c7c1bbfabef"}},"artifact":{"formatVersion":1,"sourceIntegrity":"sha256-zoTRqvs+3jkDv1n3KumPqsiVp1ChUk88z6UbQBenR/k=","controlProfile":"production","resolvedKeymap":{"ArrowDown":"rehearsal.skipScene","ArrowRight":"rehearsal.skipAction","Space":"rehearsal.skipPose"},"resolvedKeymapIntegrity":"sha256-4HY+2+kNFKdEMBhbSMbnpMeVd9syz+4sGgREYkkI0OI=","historyNavigationEnabled":false},"application":{"mode":"story"},"