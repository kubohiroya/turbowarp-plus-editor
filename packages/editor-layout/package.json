{
  "name": "@kubohiroya/turbowarp-editor-layout",
  "version": "0.1.0",
  "description": "Resizable panes for the TurboWarp editor",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standard-layout": {
      "types": "./dist/standard-layout.d.ts",
      "default": "./dist/standard-layout.js"
    },
    "./editor.css": "./src/editor.css",
    "./targets.css": "./src/targets.css"
  },
  "files": [
    "dist",
    "src/*.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test test/*.test.ts",
    "test:browser": "node --test test/layout.browser.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor.git",
    "directory": "packages/editor-layout"
  }
}
