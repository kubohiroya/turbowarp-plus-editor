{
  "name": "@kubohiroya/turbowarp-plus-editor",
  "version": "0.2.0-rc.3",
  "description": "TurboWarp-Plus-Editorの配信、ブランド資産、作品を編集するボタン",
  "type": "module",
  "license": "(GPL-3.0-or-later AND MPL-2.0)",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-plus-editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-plus-editor/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./extension-loader": {
      "types": "./dist/src/extension-loader.d.ts",
      "default": "./dist/src/extension-loader.js"
    },
    "./assets/icon.svg": "./assets/icon.svg",
    "./assets/edit-button.css": "./assets/edit-button.css",
    "./source.json": "./site/source.json"
  },
  "files": [
    "docs/extension-loader-integration.md",
    "docs/extension-authoring-ui.md",
    "assets",
    "site/source.json",
    "README.md",
    "LICENSE",
    "LICENSE.MPL-2.0",
    "NOTICE",
    "dist/src",
    "dist/config",
    "dist/scripts/yaml-editor",
    "dist/scripts/sb3-save-format",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --import ./test/asset-hooks.mjs test/*.test.ts",
    "test:extension-host": "node --test --import ./test/asset-hooks.mjs test/extension-host/*.test.mjs test/extension-library/*.test.mjs test/extension-library/*.test.cjs test/packager/*.test.mjs test/packager/*.test.cjs test/block-editor/*.test.mjs",
    "build:pages": "node scripts/site/build.ts",
    "test:e2e": "playwright test --config test/e2e/turbowarp/playwright.config.cts",
    "test:e2e:block-editor": "npm run test:e2e",
    "test:e2e:fixed-inputs": "E2E_FIXED_INPUTS=1 npm run test:e2e",
    "test:e2e:infrastructure": "node --test test/e2e/ci-gate.test.ts test/e2e/turbowarp/infrastructure.test.cts",
    "test:e2e:native": "E2E_NATIVE=1 npm run test:e2e",
    "build:extension-preview": "node scripts/site/build-extension-preview.ts",
    "test:e2e:extension-loader": "playwright test --config test/e2e/extension-loader/playwright.config.cts",
    "test:extension-loader:desktop": "node test/e2e/extension-loader/desktop.cts",
    "build:yaml-tools": "node scripts/site/build-yaml-editor.ts",
    "editor:yaml": "node scripts/yaml-editor/cli.ts",
    "test:yaml": "node --test test/yaml-build.test.ts test/yaml-cli.test.ts",
    "test:yaml:browser": "node --test test/document-sources.browser.ts",
    "test:yaml:roundtrip": "node --test test/yaml-roundtrip.browser.ts",
    "test:yaml:multi-document": "node --test test/yaml-multi-document.browser.ts",
    "editor:sb3-format": "node scripts/sb3-save-format/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:test-driver": "tsc -p test/vscode-edit-driver/tsconfig.json",
    "test:package": "npm run build && node --test test/package/*.test.ts",
    "test:script-transfer": "node --test test/script-transfer/*.test.mjs",
    "test:gui-integration": "node --test --import ./test/asset-hooks.mjs \"test/gui-integration/**/*.test.mjs\" \"test/gui-integration/**/*.test.cjs\"",
    "preview:security": "node scripts/local-security-preview.cjs"
  },
  "devDependencies": {
    "@kubohiroya/turbowarp-document-source": "0.1.0-rc.0",
    "@kubohiroya/turbowarp-extension-data-editor": "0.7.0",
    "@kubohiroya/turbowarp-extension-loader": "0.8.0",
    "@kubohiroya/turbowarp-extension-security-dialog": "github:kubohiroya/turbowarp-extension-security-dialog#5c816492b39831a7c4ffeaabde01536046104c6a",
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0",
    "@kubohiroya/turbowarp-structured-data": "0.11.0-rc.0",
    "@kubohiroya/turbowarp-yaml-json": "0.8.0-rc.0",
    "@playwright/test": "^1.64.1",
    "@turbowarp/packager": "3.14.0",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.144.0",
    "ajv": "8.20.0",
    "esbuild": "0.25.12",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "yaml": "2.9.1",
    "jsdom": "26.1.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-document-data": "0.5.0-rc.1",
    "@kubohiroya/turbowarp-document-editor": "0.1.0-rc.1",
    "@kubohiroya/turbowarp-sb3-save-format": "0.4.0-rc.1",
    "@turbowarp/jszip": "^3.12.0",
    "@kubohiroya/turbowarp-script-transfer": "git+https://github.com/kubohiroya/turbowarp-script-transfer.git#6f6f9c3f0e7a6c601a8046777ae8289968d36800"
  },
  "bin": {
    "turbowarp-plus-editor-yaml": "dist/scripts/yaml-editor/cli.js",
    "turbowarp-plus-editor-sb3-format": "dist/scripts/sb3-save-format/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "overrides": {
    "@kubohiroya/turbowarp-document-source": "$@kubohiroya/turbowarp-document-source",
    "@kubohiroya/turbowarp-extension-loader": "$@kubohiroya/turbowarp-extension-loader"
  }
}
