{
  "name": "@kubohiroya/turbowarp-plus-editor",
  "version": "0.2.0-rc.4",
  "description": "Distribution, brand assets and the project edit button for TurboWarp-Plus-Editor",
  "type": "module",
  "license": "(GPL-3.0-or-later AND MPL-2.0)",
  "author": {
    "name": "Hiroya Kubo",
    "email": "hiroya@cuc.ac.jp",
    "url": "https://github.com/kubohiroya"
  },
  "homepage": "https://kubohiroya.github.io/turbowarp-plus-editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-plus-editor.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-plus-editor/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./extension-loader": {
      "types": "./dist/src/extension-loader.d.ts",
      "default": "./dist/src/extension-loader.js"
    },
    "./assets/icon.svg": "./assets/icon.svg",
    "./assets/edit-button.css": "./assets/edit-button.css",
    "./source.json": "./site/source.json"
  },
  "files": [
    "docs/extension-loader-integration.md",
    "docs/extension-authoring-ui.md",
    "assets",
    "site/source.json",
    "README.md",
    "LICENSE",
    "LICENSE.MPL-2.0",
    "NOTICE",
    "dist/src",
    "dist/config",
    "dist/scripts/yaml-editor",
    "dist/scripts/sb3-save-format",
    "README.ja.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --import ./test/asset-hooks.ts test/*.test.ts packages/*/test/*.test.ts",
    "test:extension-host": "node --test --import ./test/asset-hooks.ts test/extension-host/*.test.ts test/extension-library/*.test.ts test/extension-library/*.test.cts test/packager/*.test.ts test/packager/*.test.cts test/block-editor/*.test.ts",
    "build:pages": "node scripts/site/build.ts",
    "test:e2e": "playwright test --config test/e2e/turbowarp/playwright.config.cts",
    "test:e2e:block-editor": "npm run test:e2e",
    "test:e2e:fixed-inputs": "E2E_FIXED_INPUTS=1 npm run test:e2e",
    "test:e2e:infrastructure": "node --test test/e2e/ci-gate.test.ts test/e2e/turbowarp/infrastructure.test.cts",
    "test:e2e:native": "E2E_NATIVE=1 npm run test:e2e",
    "build:extension-preview": "node scripts/site/build-extension-preview.ts",
    "test:e2e:extension-loader": "playwright test --config test/e2e/extension-loader/playwright.config.cts",
    "test:extension-loader:desktop": "node test/e2e/extension-loader/desktop.cts",
    "build:yaml-tools": "node scripts/site/build-yaml-editor.ts",
    "editor:yaml": "node scripts/yaml-editor/cli.ts",
    "test:yaml": "node --test test/yaml-build.test.ts test/yaml-cli.test.ts",
    "test:yaml:roundtrip": "node --test test/yaml-roundtrip.browser.ts",
    "test:yaml:multi-document": "node --test --test-concurrency=1 test/yaml-multi-document.browser.ts test/yaml-dockview.browser.ts test/dockview-restore.browser.ts",
    "editor:sb3-format": "node scripts/sb3-save-format/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:test-driver": "tsc -p test/vscode-edit-driver/tsconfig.json",
    "test:package": "npm run build && node --test test/package/*.test.ts",
    "test:script-transfer": "node --test test/script-transfer/*.test.ts",
    "test:project-tools": "node --test test/project-tools/*.test.ts && node --test test/project-tools/*.test.cts",
    "test:gui-integration": "node --test --import ./test/asset-hooks.ts \"test/gui-integration/**/*.test.ts\" \"test/gui-integration/**/*.test.cts\"",
    "test:editor-host": "node --test test/editor-host.browser.ts",
    "preview:security": "node scripts/local-security-preview.cts"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "0.24.0",
    "@kubohiroya/turbowarp-document-source": "0.2.0-rc.0",
    "@kubohiroya/turbowarp-editor-backpack": "file:packages/editor-backpack",
    "@kubohiroya/turbowarp-editor-surfaces": "file:packages/editor-surfaces",
    "@kubohiroya/turbowarp-editor-transfer": "file:packages/editor-transfer",
    "@kubohiroya/turbowarp-extension-data-editor": "0.8.2",
    "@kubohiroya/turbowarp-extension-loader": "0.11.0",
    "@kubohiroya/turbowarp-extension-security-dialog": "0.8.9",
    "@kubohiroya/turbowarp-named-data": "0.8.0-rc.0",
    "@kubohiroya/turbowarp-plus-editor-auth": "0.5.0",
    "@kubohiroya/turbowarp-plus-editor-git": "file:vendor/kubohiroya-turbowarp-plus-editor-git-0.20.0-file-commit.34.tgz",
    "@kubohiroya/turbowarp-plus-editor-host": "0.1.0",
    "@kubohiroya/turbowarp-plus-editor-project-folder": "file:vendor/kubohiroya-turbowarp-plus-editor-project-folder-0.9.1-file-commit.8.tgz",
    "@kubohiroya/turbowarp-plus-editor-project-model": "0.1.0",
    "@kubohiroya/turbowarp-plus-editor-project-starter": "0.1.0",
    "@kubohiroya/turbowarp-plus-editor-sprite-panes": "0.1.1",
    "@kubohiroya/turbowarp-plus-editor-ui": "file:packages/editor-ui",
    "@kubohiroya/turbowarp-plus-editor-views": "file:packages/editor-views",
    "@kubohiroya/turbowarp-plus-editor-windows": "0.1.0",
    "@kubohiroya/turbowarp-plus-editor-workbench": "0.11.0",
    "@kubohiroya/turbowarp-structured-data": "0.11.0-rc.1",
    "@kubohiroya/turbowarp-yaml-json": "0.9.0-rc.0",
    "@playwright/test": "^1.64.1",
    "@turbowarp/packager": "3.14.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.144.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "ajv": "8.20.0",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-document-data": "0.6.0-rc.2",
    "@kubohiroya/turbowarp-document-editor": "0.1.0-rc.8",
    "@kubohiroya/turbowarp-sb3-save-format": "0.4.0-rc.2",
    "@kubohiroya/turbowarp-script-transfer": "0.1.4",
    "@turbowarp/jszip": "^3.12.0"
  },
  "bin": {
    "turbowarp-plus-editor-yaml": "dist/scripts/yaml-editor/cli.js",
    "turbowarp-plus-editor-sb3-format": "dist/scripts/sb3-save-format/cli.js"
  },
  "types": "./dist/src/index.d.ts",
  "overrides": {
    "@kubohiroya/turbowarp-extension-loader": "$@kubohiroya/turbowarp-extension-loader"
  }
}
